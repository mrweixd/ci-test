+
+// Keep the underlying cause available to errors.Is/As without exposing response
+// bodies, URLs, or headers to callers that log the message or send it to peers.
+type tokenEndpointError struct{ cause error }
+
+func (e tokenEndpointError) Unwrap() error { return e.cause }
+
+func (e tokenEndpointError) Error() string {
+	var status openapi.GenericOpenAPIError
+	if errors.As(e.cause, &status) {
+		return fmt.Sprintf("NRF token endpoint: HTTP %d", status.ErrorStatus)
+	}
+	var transport *url.Error
+	if errors.As(e.cause, &transport) {
+		return fmt.Sprintf("NRF token endpoint: transport failure (%T, timeout=%t)", transport.Err, transport.Timeout())
+	}
+	return fmt.Sprintf("NRF token endpoint: request or response processing failed (%T)", e.cause)
+}
