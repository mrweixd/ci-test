@@ -0,0 +1,81 @@
+package oauth
+
+import (
+	"encoding/json"
+	"errors"
+	"github.com/free5gc/openapi"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/free5gc/openapi/models"
+	"github.com/free5gc/openapi/nrf/AccTok"
+)
+
+// Verify that failures remain distinguishable without caching a token.
+func TestPinnedTokenFailureDiagnostic(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		status     int
+		body       string
+		disconnect bool
+	}{
+		{"HTTP_403", http.StatusForbidden, `{"status":403}`, false},
+		{"HTTP_503", http.StatusServiceUnavailable, `{"status":503}`, false},
+		{"invalid_JSON_on_200", http.StatusOK, `{`, false},
+		{"closed_listener", 0, "", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method != http.MethodPost || r.URL.Path != "/oauth2/token" {
+					t.Errorf("unexpected endpoint %s %s", r.Method, r.URL.Path)
+				}
+				w.Header().Set("Content-Type", "application/json")
+				w.WriteHeader(tc.status)
+				_, _ = w.Write([]byte(tc.body))
+			}))
+			t.Cleanup(server.Close)
+			if tc.disconnect {
+				server.Close()
+			}
+			cfg := AccTok.NewConfiguration()
+			cfg.SetBasePath(server.URL)
+			cfg.SetHTTPClient(server.Client())
+			clientMap.Store(server.URL, AccTok.NewAPIClient(cfg))
+			t.Cleanup(func() { clientMap.Delete(server.URL) })
+			req := TokenRequest{
+				ConsumerNFType: models.Nrf_NFMgmt_NFType_AUSF, ConsumerNFInstanceID: "test-ausf",
+				TargetNFType: models.Nrf_NFMgmt_NFType_NRF, NRFURI: server.URL, Scope: "nnrf-disc",
+			}
+			ctx, pd, err := GetTokenCtx(req)
+			if ctx != nil || pd != nil || err == nil {
+				t.Fatalf("ctxPresent=%t, problemPresent=%t, err=%v", ctx != nil, pd != nil, err)
+			}
+			var httpErr openapi.GenericOpenAPIError
+			var transport *url.Error
+			var syntax *json.SyntaxError
+			switch {
+			case tc.disconnect:
+				if !errors.As(err, &transport) {
+					t.Fatalf("missing transport error: %v", err)
+				}
+			case tc.status == 200:
+				if !errors.As(err, &syntax) {
+					t.Fatalf("missing parser error: %v", err)
+				}
+			default:
+				if !errors.As(err, &httpErr) || httpErr.ErrorStatus != tc.status {
+					t.Fatalf("missing status: %v", err)
+				}
+			}
+			if strings.Contains(err.Error(), server.URL) || strings.Contains(err.Error(), tc.body) && tc.body != "" {
+				t.Fatalf("diagnostic exposes request URL or response body")
+			}
+			if _, ok := tokenMap.Load(tokenCacheKey(req)); ok {
+				t.Fatal("failed response was cached")
+			}
+		})
+	}
+}
